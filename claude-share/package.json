{
  "name": "@0xpv/claude-share",
  "version": "0.1.0-alpha.1",
  "description": "Share your Claude Code subscription with others on your local network",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "share",
    "proxy"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-share": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "lint": "oxlint src",
    "fmt": "oxfmt --config ../.oxfmtrc.json src",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@hono/node-server": "^2.0.1",
    "@noble/ciphers": "^2.2.0",
    "cloudflared": "^0.7.1",
    "hono": "^4.12.16",
    "http-mitm-proxy": "^1.1.0",
    "ink": "^7.0.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/node-forge": "1.3.14",
    "@types/react": "latest",
    "@types/semaphore": "1.1.4",
    "@types/ws": "8.18.1",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "typescript": "latest"
  }
}
