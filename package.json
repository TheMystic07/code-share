{
  "name": "@0xpv/claude-share",
  "version": "0.7.0-alpha",
  "description": "Share or connect to a Claude Code subscription",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "share",
    "proxy"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-share": "./claude-share/dist/index.js",
    "claude-connect": "./claude-receive/dist/index.js"
  },
  "files": [
    "claude-share/dist",
    "claude-receive/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p claude-share/tsconfig.json && tsc -p claude-receive/tsconfig.json",
    "dev:share": "bun claude-share/src/index.ts",
    "dev:connect": "bun claude-receive/src/index.ts",
    "start:share": "node claude-share/dist/index.js",
    "start:connect": "node claude-receive/dist/index.js",
    "lint": "oxlint claude-share/src claude-receive/src",
    "fmt": "oxfmt --config .oxfmtrc.json claude-share/src claude-receive/src",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@hono/node-server": "^2.0.1",
    "@noble/ciphers": "^2.2.0",
    "hono": "^4.12.16",
    "http-mitm-proxy": "^1.1.0",
    "ink": "^7.0.1",
    "node-forge": "^1.4.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/node-forge": "1.3.14",
    "@types/react": "latest",
    "@types/semaphore": "1.1.4",
    "@types/ws": "8.18.1",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "typescript": "latest"
  }
}
