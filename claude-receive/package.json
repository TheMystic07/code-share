{
  "name": "@0xpv/claude-receive",
  "version": "0.3.2-alpha",
  "description": "Connect to a shared Claude Code instance on your local network",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "receive",
    "proxy"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-receive": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "lint": "oxlint src",
    "fmt": "oxfmt --config ../.oxfmtrc.json src",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@noble/ciphers": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "typescript": "latest"
  }
}
